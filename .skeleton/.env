# ------------------------------------------------------------------------------
# Container version overrides. Update these values and restart your containers
# (i.e. 'docker compose up -d') to update the versions of your services.
# ------------------------------------------------------------------------------

# OUTLINE_VERSION=latest

# ------------------------------------------------------------------------------
# The container ports to be exposed to the host.
# ------------------------------------------------------------------------------

# OUTLINE_PORT=3000

# ------------------------------------------------------------------------------
# The app URL. Should point to the fully qualified, publicly accessible, URL.
# ------------------------------------------------------------------------------

OUTLINE_URL=

# ------------------------------------------------------------------------------
# User session / auth cookie secret key. Must be a hex-encoded 32-byte random
# value. Use `openssl rand -hex 32` to generate the required random value.
# ------------------------------------------------------------------------------

OUTLINE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Utility encryption key. Any sufficiently long random value will suffice.
# ------------------------------------------------------------------------------

OUTLINE_UTILS_SECRET=

# ------------------------------------------------------------------------------
# The database configuration. Only the password is required when using the
# provided 'postgres' container.
# ------------------------------------------------------------------------------

# DATABASE_HOST=database
# DATABASE_NAME=outline
# DATABASE_USER=outline
DATABASE_PASSWORD=

# ------------------------------------------------------------------------------
# Container data volumes. Absolute or relative path to the 'docker-compose.yaml'
# file or a named Docker volume. Defaults to a pre-configured, named volume.
# ------------------------------------------------------------------------------

# OUTLINE_VOLUME=outline-data
# DATABASE_VOLUME=postgres-data
# CACHE_VOLUME=valkey-data

# ------------------------------------------------------------------------------
# Host user and group to be mapped to the running container user and group to
# align permissions between the host machine and docker container.
# ------------------------------------------------------------------------------

# HOST_USER=
# HOST_GROUP=
